# Required for the default `api` backend. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Translator model auto-pulled into the bundled Ollama on first run.
# Smaller/faster alternative: qwen2.5:3b
SIGO_TRANSLATOR_MODEL=qwen2.5:7b

# Claude model used for responses.
SIGO_CLAUDE_MODEL=claude-sonnet-4-6
